# Names only. Values arrive in later stages; never commit real secrets.
# Database (Neon pooled connection string)
DATABASE_URL=
# Auth (Neon Auth / managed Better Auth)
NEON_AUTH_BASE_URL=
# 32+ random characters (openssl rand -base64 32)
NEON_AUTH_COOKIE_SECRET=
# Only this email can become the owner (Neon Auth sign-up is public). Unset = nobody can claim.
OWNER_EMAIL=
# Stage 8 (market data). MARKET_PROVIDER: twelvedata | none. Server-only; the key is never sent to the browser.
MARKET_PROVIDER=
MARKET_API_KEY=
# "true" only if your Twelve Data plan serves real-time data (otherwise quotes are labelled delayed)
MARKET_REALTIME=
# Stage 9 (Eddie)
AI_GATEWAY_API_KEY=
EDDIE_MODEL=
